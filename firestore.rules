rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ==============================================================
    // Assumptions and supported data models
    // ==============================================================
    // Global catalogs (client writes denied):
    // - lessons/{lessonId}; Spark activity answers are public educational content
    // - modules/{moduleId}
    // - achievements/{achievementId}
    // - dailyMissions/{missionId}
    //
    // Private V1 data, scoped by the UID in the path:
    // - users/{uid}
    // - users/{uid}/{transactions|goals|budgets|reminders}/{documentId}
    // - users/{uid}/lessonProgress/{progressId}
    //
    // Transition paths for Phase 1:
    // - users/{uid}/achievementProgress/{achievementId}
    // - users/{uid}/dailyMissionProgress/{yyyy-MM-dd}
    // - users/{uid}/learningStats/streak
    //
    // Legacy transition path:
    // - achievementProgress/{progressId}, owned through its userId field
    //
    // Known legacy fields are accepted only where existing V1 documents need
    // them: transactions.automatic/isAutomatic, budgets.paid/isPaid,
    // lessonProgress.completed/isCompleted and achievementProgress.unlocked.
    // Unknown fields and unknown paths are denied.

    // ==============================================================
    // Shared helpers
    // ==============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function hasRequired(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnly(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function validString(data, field, maxLength) {
      return data[field] is string && data[field].size() <= maxLength;
    }

    function validNonEmptyString(data, field, maxLength) {
      return data[field] is string
        && data[field].size() > 0
        && data[field].size() <= maxLength;
    }

    function validOptionalString(data, field, maxLength) {
      return !data.keys().hasAny([field])
        || data[field] == null
        || (data[field] is string && data[field].size() <= maxLength);
    }

    function validOptionalBool(data, field) {
      return !data.keys().hasAny([field])
        || data[field] == null
        || data[field] is bool;
    }

    function validOptionalInt(data, field, minimum, maximum) {
      return !data.keys().hasAny([field])
        || data[field] == null
        || (data[field] is int
          && data[field] >= minimum
          && data[field] <= maximum);
    }

    function validOptionalTimestamp(data, field) {
      return !data.keys().hasAny([field])
        || data[field] == null
        || data[field] is timestamp;
    }

    function validOptionalList(data, field, maxSize) {
      return !data.keys().hasAny([field])
        || (data[field] is list && data[field].size() <= maxSize);
    }

    function validMoney(value) {
      return value is number && value >= 0 && value <= 1000000000000;
    }

    function validEmail(value) {
      return value is string
        && value.size() > 3
        && value.size() <= 254
        && value.matches('^[^@]+@[^@]+[.][^@]+$');
    }

    // ==============================================================
    // Domain validators for current V1 private data
    // ==============================================================
    function isValidUser(data) {
      return hasRequired(data, ['name', 'email', 'level', 'xp', 'nextLevelXp'])
        && hasOnly(data, ['name', 'email', 'level', 'xp', 'nextLevelXp'])
        && validNonEmptyString(data, 'name', 120)
        && validEmail(data.email)
        && data.level is int && data.level >= 1 && data.level <= 1000000
        && data.xp is int && data.xp >= 0 && data.xp <= 1000000000
        && data.nextLevelXp is int
        && data.nextLevelXp >= 1
        && data.nextLevelXp <= 1000000000;
    }

    function isValidTransaction(data) {
      return hasRequired(data, ['title', 'category', 'amount', 'type', 'date'])
        && hasOnly(data, [
          'title', 'category', 'amount', 'type', 'date',
          'automatic', 'isAutomatic'
        ])
        && data.keys().hasAny(['automatic', 'isAutomatic'])
        && validString(data, 'title', 200)
        && validString(data, 'category', 120)
        && validMoney(data.amount)
        && data.type is string && data.type in ['RECEITA', 'DESPESA']
        && data.date is timestamp
        && validOptionalBool(data, 'automatic')
        && validOptionalBool(data, 'isAutomatic');
    }

    function isValidGoal(data) {
      return hasRequired(data, [
          'title', 'targetAmount', 'currentAmount', 'deadline'
        ])
        && hasOnly(data, [
          'title', 'targetAmount', 'currentAmount', 'deadline', 'deadlineDate',
          'completedAt', 'rewardPolicyVersion', 'createdAt'
        ])
        && validString(data, 'title', 200)
        && validMoney(data.targetAmount)
        && validMoney(data.currentAmount)
        && data.deadline is string
        && data.deadline in ['CURTO', 'MEDIO', 'LONGO']
        && validOptionalTimestamp(data, 'deadlineDate')
        && validOptionalTimestamp(data, 'completedAt')
        && validOptionalInt(data, 'rewardPolicyVersion', 1, 1)
        && validOptionalTimestamp(data, 'createdAt');
    }

    function isValidSparkProgress(data, lessonId) {
      return hasRequired(data, ['lessonId', 'isCompleted', 'completedActivityIds'])
        && hasOnly(data, [
          'lessonId', 'isCompleted', 'completedActivityIds', 'lastAccessed',
          'completedAt', 'lastActivityId', 'userId', 'completed',
          'validatedActivityIds', 'activityValidationProofs',
          'activityValidationVersion', 'completionValidationVersion'
        ])
        && data.lessonId == lessonId
        && data.isCompleted is bool
        && data.completedActivityIds is list
        && data.completedActivityIds.size() <= 9
        && validOptionalTimestamp(data, 'lastAccessed')
        && validOptionalTimestamp(data, 'completedAt')
        && validOptionalString(data, 'lastActivityId', 200);
    }

    function validSparkProgressAddition(lessonId) {
      return request.resource.data.isCompleted == false
        && resource.data.isCompleted == false
        && request.resource.data.lastActivityId is string
        && request.resource.data.lastActivityId.size() > 0
        && request.resource.data.completedActivityIds.size() ==
          resource.data.completedActivityIds.size() + 1
        && request.resource.data.completedActivityIds.hasAll(resource.data.completedActivityIds)
        && request.resource.data.lastActivityId in request.resource.data.completedActivityIds
        && !(request.resource.data.lastActivityId in resource.data.completedActivityIds)
        && exists(/databases/$(database)/documents/lessons/$(lessonId)/blocks/$(request.resource.data.lastActivityId))
        && get(/databases/$(database)/documents/lessons/$(lessonId)/blocks/$(request.resource.data.lastActivityId)).data.type == 'ACTIVITY';
    }

    function isValidBudget(data) {
      return hasRequired(data, [
          'category', 'limitAmount', 'spentAmount', 'type'
        ])
        && hasOnly(data, [
          'category', 'limitAmount', 'spentAmount', 'type', 'dueDay',
          'isPaid', 'paid', 'lastPaymentDate', 'lastClosedMonth'
        ])
        && validString(data, 'category', 120)
        && validMoney(data.limitAmount)
        && validMoney(data.spentAmount)
        && data.type is string && data.type in ['FIXO', 'VARIAVEL']
        && validOptionalInt(data, 'dueDay', 1, 31)
        && validOptionalBool(data, 'isPaid')
        && validOptionalBool(data, 'paid')
        && validOptionalTimestamp(data, 'lastPaymentDate')
        && validOptionalTimestamp(data, 'lastClosedMonth');
    }

    function isValidReminder(data) {
      return hasRequired(data, [
          'title', 'description', 'amount', 'date', 'time', 'isCompleted'
        ])
        && hasOnly(data, [
          'title', 'description', 'amount', 'date', 'time', 'isCompleted'
        ])
        && validString(data, 'title', 200)
        && validString(data, 'description', 1000)
        && validMoney(data.amount)
        && data.date is timestamp
        && validString(data, 'time', 20)
        && data.isCompleted is bool;
    }

    function isValidLegacyAchievementProgress(data) {
      return hasRequired(data, [
          'userId', 'achievementId', 'currentProgress',
          'isUnlocked', 'lastUpdated'
        ])
        && hasOnly(data, [
          'userId', 'achievementId', 'currentProgress',
          'isUnlocked', 'unlocked', 'lastUpdated'
        ])
        && validNonEmptyString(data, 'userId', 128)
        && validNonEmptyString(data, 'achievementId', 200)
        && data.currentProgress is int
        && data.currentProgress >= 0
        && data.currentProgress <= 1000000000
        && data.isUnlocked is bool
        && validOptionalBool(data, 'unlocked')
        && data.lastUpdated is timestamp;
    }

    function isLegacyAchievementType(achievementId) {
      return exists(/databases/$(database)/documents/achievements/$(achievementId))
        && get(/databases/$(database)/documents/achievements/$(achievementId))
          .data.requirementType in [
            'TRANSACTION_COUNT', 'LESSON_COUNT', 'GOAL_COUNT', 'MONTHLY_SAVINGS'
          ];
    }

    // ==============================================================
    // Global catalogs
    // ==============================================================
    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /blocks/{blockId} {
        // O gabarito é público no Spark. Acerto é gamificação, não prova segura.
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    match /modules/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /achievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /dailyMissions/{missionId} {
      // O gabarito é público no Spark e nunca é tratado como segredo.
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ==============================================================
    // User-owned private data
    // ==============================================================
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidUser(request.resource.data)
        && request.auth.token.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.level == 1
        && request.resource.data.xp == 0
        && request.resource.data.nextLevelXp == 100;
      allow update: if isOwner(uid)
        && isValidUser(request.resource.data)
        && request.resource.data.email == resource.data.email
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['xp', 'level', 'nextLevelXp']);
      allow delete: if false;

      match /transactions/{transactionId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidTransaction(request.resource.data);
        allow update: if isOwner(uid)
          && isValidTransaction(request.resource.data)
          && request.resource.data.date == resource.data.date;
        allow delete: if isOwner(uid);
      }

      match /goals/{goalId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && isValidGoal(request.resource.data)
          && !request.resource.data.keys().hasAny(['rewardPolicyVersion', 'createdAt']);
        allow update: if isOwner(uid)
          && isValidGoal(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['rewardPolicyVersion', 'createdAt'])
          && (resource.data.get('completedAt', null) == null ||
            request.resource.data.get('completedAt', null) == resource.data.completedAt);
        allow delete: if isOwner(uid);
      }

      match /goalCreationRequests/{requestId} {
        allow read, write: if false;
      }

      match /budgets/{budgetId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidBudget(request.resource.data);
        allow update: if isOwner(uid)
          && isValidBudget(request.resource.data)
          && request.resource.data.type == resource.data.type;
        allow delete: if isOwner(uid);
      }

      match /reminders/{reminderId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidReminder(request.resource.data);
        allow update: if isOwner(uid) && isValidReminder(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /lessonProgress/{progressId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && progressId == request.resource.data.lessonId
          && exists(/databases/$(database)/documents/lessons/$(progressId))
          && isValidSparkProgress(request.resource.data, progressId)
          && request.resource.data.keys().hasOnly([
            'lessonId', 'isCompleted', 'completedActivityIds', 'lastAccessed', 'completedAt'
          ])
          && request.resource.data.isCompleted == false
          && request.resource.data.completedActivityIds.size() == 0
          && request.resource.data.completedAt == null
          && request.resource.data.lastAccessed == request.time;
        allow update: if isOwner(uid)
          && isValidSparkProgress(request.resource.data, progressId)
          && request.resource.data.lessonId == resource.data.lessonId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isCompleted', 'completedActivityIds', 'lastAccessed',
            'completedAt', 'lastActivityId'
          ])
          && resource.data.isCompleted == false
          && (
            (request.resource.data.isCompleted == false
              && request.resource.data.completedAt == resource.data.get('completedAt', null)
              && request.resource.data.lastAccessed == request.time
              && validSparkProgressAddition(progressId))
            ||
            (request.resource.data.isCompleted == true
              && request.resource.data.completedActivityIds == resource.data.completedActivityIds
              && request.resource.data.completedActivityIds.size() == 3
              && request.resource.data.completedAt == request.time)
          );
        allow delete: if false;
      }

      match /achievementProgress/{achievementId} {
        allow read: if isOwner(uid);
        // MODULE_COMPLETION and STREAK are granted by backend transactions.
        // The Android client cannot forge an unlock in this path.
        allow write: if false;
      }

      // A missão é gamificação autodeclarada. Não concede XP ou conquistas.
      match /dailyMissionProgress/{dateId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && hasRequired(request.resource.data, ['missionId', 'date', 'isCompleted', 'completedAt'])
          && hasOnly(request.resource.data, ['missionId', 'date', 'isCompleted', 'completedAt'])
          && request.resource.data.date == dateId
          && dateId.matches('^20[0-9][0-9]-[0-1][0-9]-[0-3][0-9]$')
          && request.resource.data.missionId is string
          && exists(/databases/$(database)/documents/dailyMissions/$(request.resource.data.missionId))
          && request.resource.data.isCompleted == true
          && request.resource.data.completedAt == request.time;
        allow update, delete: if false;
      }

      match /learningStats/streak {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ==============================================================
    // Legacy root achievement progress
    // ==============================================================
    match /achievementProgress/{progressId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      // Historical records remain readable; only trusted backend writes progress.
      allow write: if false;
    }

    // Explicit default deny for every unlisted collection and nested path.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
